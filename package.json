{
  "name": "keyloop-service-scheduler",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview --port 4173",
    "lint": "eslint .",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "e2e": "playwright test",
    "contract:lint": "redocly lint contracts/openapi.yaml --extends=recommended",
    "contract:gen": "openapi-typescript contracts/openapi.yaml -o src/api/schema.gen.ts",
    "contract:check": "pnpm contract:gen && git diff --exit-code -- src/api/schema.gen.ts",
    "format": "prettier --write ."
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  },
  "dependencies": {
    "@date-fns/tz": "^1.5.0",
    "@hookform/resolvers": "^7.0.1",
    "@radix-ui/react-alert-dialog": "^1.2.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@tanstack/react-query": "^5.105.2",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "msw": "^2.15.0",
    "openapi-fetch": "^0.17.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-error-boundary": "^6.1.6",
    "react-hook-form": "^7.91.0",
    "react-router": "^7.18.5",
    "tailwind-merge": "^3.7.0",
    "web-vitals": "^6.2.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@redocly/cli": "^2.72.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "@vitest/coverage-v8": "^3.2.7",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "eslint": "^9.39.5",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "jsdom": "^30.1.3",
    "openapi-typescript": "^7.13.0",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^6.4.5",
    "vitest": "^3.2.7",
    "vitest-axe": "^0.1.0",
    "yaml": "^2.9.1"
  }
}
